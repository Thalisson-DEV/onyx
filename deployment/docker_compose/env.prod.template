# Fill in the values and copy the contents of this file to .env in the deployment directory.
# Some valid default values are provided where applicable, delete the variables which you don't set values for.
# This is only necessary when using the docker-compose.prod.yml compose file.
#
# No credential in this file ships with a value. Every key marked "REQUIRED"
# must be filled in, or injected from a secret store, before the first start.
# Docker Compose refuses to start and names the missing variable. Never commit a
# filled-in copy of this file.


# Could be something like onyx.companyname.com
WEB_DOMAIN=http://localhost:3000

# Set to false to let any origin embed Onyx in an <iframe>, disabling
# clickjacking protection. Protected by default.
# WEB_FRAME_PROTECTION_ENABLED=false

# Set to true to add strict Content-Security-Policy directives
# (default-src/script-src/connect-src/etc.) restricting where scripts load
# from and where data can be sent. Off by default.
# WEB_STRICT_CSP_ENABLED=true

# User authentication is always enabled. Email/password login works out of the
# box, and the first user to sign up becomes an admin.
# SSO (Google / OIDC / SAML) and its per-provider options are configured in the
# admin panel (Admin Panel > Organization > SSO Providers), no env vars needed.
# See https://docs.onyx.app/deployment/authentication for details.

# Legacy pre-v4.4 SSO configuration. Imported into an SSO provider entry on
# upgrade, so keep these set through the upgrade. Planned for removal in v4.5.
#AUTH_TYPE=
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
#OAUTH_CLIENT_ID=
#OAUTH_CLIENT_SECRET=
#OPENID_CONFIG_URL=
# Forces PKCE on for every provider. Superseded by the per-provider setting.
#OIDC_PKCE_ENABLED=
# SAML config directory for pre-v4.4 OneLogin compatible setups
#SAML_CONF_DIR=

# if you want to require email verification,
# then uncomment / set the following
#REQUIRE_EMAIL_VERIFICATION=true
#SMTP_USER=your-email@company.com
#SMTP_PASS=

# The below are only needed if you aren't using gmail as your SMTP
#SMTP_SERVER=  
#SMTP_PORT=
# When missing SMTP_USER, this is used instead
#EMAIL_FROM=
# Optional comma-separated BCC archive recipients for all emails
#EMAIL_ARCHIVE_BCC_ADDRESSES=

# How long before user needs to reauthenticate, default to 7 days. (cookie expiration time)
SESSION_EXPIRE_TIME_SECONDS=604800


# Use the below to specify a list of allowed user domains
# e.g. `VALID_EMAIL_DOMAINS=example.com,example.org` will only allow users
# with an @example.com or an @example.org email
#VALID_EMAIL_DOMAINS=


# Set to "true" to restrict GET /users to admins. Non-admins can't enumerate
# accounts or share agents with individual users; group sharing still works.
#USER_DIRECTORY_ADMIN_ONLY=


# REQUIRED unless USE_IAM_AUTH=true. Generate with: openssl rand -hex 32
# Postgres reads POSTGRES_PASSWORD once, when its data volume is first created.
# Changing it later also needs: ALTER ROLE <user> WITH PASSWORD '<new>';
POSTGRES_USER=postgres
POSTGRES_PASSWORD=


# REQUIRED when you use the read-only user for the knowledge graph and other
# future read-only purposes. Generate a value distinct from POSTGRES_PASSWORD, or
# delete both keys if the read-only user is not in use.
DB_READONLY_USER=db_readonly_user
DB_READONLY_PASSWORD=


# REQUIRED. Signs password reset, email verification, OAuth login state and
# captcha cookies; the API server refuses to start without it.
# Generate with: openssl rand -hex 32
USER_AUTH_SECRET=


# REQUIRED. Wraps every encrypted column at rest: connector credentials,
# LLM/voice/search provider API keys, bot tokens, SSO and MCP configuration.
# Without it those columns are written as plaintext bytes. The prod compose files
# refuse to start when it is missing.
# Generate with: openssl rand -hex 32
# Rotating it requires re-encrypting existing rows with the previous key:
#   python -m onyx.db.rotate_encryption_key
ENCRYPTION_KEY_SECRET=


# REQUIRED. The same value bootstraps the OpenSearch admin user and
# authenticates the application to it. OpenSearch rejects weak values: at least
# 8 characters with an upper-case letter, a lower-case letter, a digit and a
# special character, for example
#   printf '%s' "$(openssl rand -base64 24)Aa1!"
OPENSEARCH_ADMIN_PASSWORD=


# REQUIRED when FILE_STORE_BACKEND=s3 (the default). Anyone who reaches the
# object-storage endpoint with these can read or modify every stored file.
# Keep the S3_AWS_* pair identical to MINIO_ROOT_* (the app uses MinIO's root
# credentials).
#   MINIO_ROOT_USER / S3_AWS_ACCESS_KEY_ID           openssl rand -hex 16
#   MINIO_ROOT_PASSWORD / S3_AWS_SECRET_ACCESS_KEY   openssl rand -hex 32
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=


# Leave ENABLE_PAID_ENTERPRISE_EDITION_FEATURES unset unless you hold a valid
# license: setting it true without one puts the whole application into gated
# access. LICENSE_ENFORCEMENT_ENABLED also stays unset; its default keeps the
# shared implementation tree loaded, which computes group-aware document access.

# If setting the vespa language is required, set this ('en', 'de', etc.).
# See: https://docs.vespa.ai/en/linguistics.html 
#VESPA_LANGUAGE_OVERRIDE=

# Show extra/uncommon connectors
# See https://docs.onyx.app/admins/connectors/overview for a full list of connectors
SHOW_EXTRA_CONNECTORS=False
